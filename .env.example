# Rastro configuration. Copy to .env (gitignored) and adjust. Placeholders only: never commit
# real keys. Contract deployment keys live in contracts/.env.testnet (see contracts/.env.example).

# --- backend (FastAPI, backend/app/config.py) ---
# Published data bundle the API serves; relative paths resolve from the repository root.
RASTRO_DATA_DIR=web/public/data
# Fall back to web/public/data/mock/<file> when the real file is missing (labelled "mock").
RASTRO_ALLOW_MOCK=true
# Comma-separated browser origins allowed to call the API.
RASTRO_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Canonical dataset served under /api/v1 (needs derived/ geo + risk outputs), and the pipeline package.
RASTRO_DATASET_DIR=data/synthetic/evaluation
RASTRO_PIPELINE_DIR=pipeline
# Chain reads: auto = live RPC, else the labelled recorded replay; local = replay only; rpc = live only.
RASTRO_CHAIN_MODE=auto
# RASTRO_RPC_URL=http://127.0.0.1:8545
RASTRO_RPC_TIMEOUT_S=2
# Investigator review log (default <dataset>/derived/reviews).
# RASTRO_STATE_DIR=data/state
RASTRO_WARM_LINEAGE=true
RASTRO_LOG_LEVEL=INFO
# The backend never holds keys: there is deliberately no signer variable here.

# --- pipeline ---
# 1 = red-team world (launderers hold 60-120 days and chain two hops).
RASTRO_STRESS=0

# --- web (Vite; only VITE_* reach the browser, so never put a secret here) ---
# VITE_BASE=/rastro/
# VITE_API_URL=http://127.0.0.1:8000
